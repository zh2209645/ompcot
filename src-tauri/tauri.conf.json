{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ompcot",
  "identifier": "works.zephyrq.ompcot",
  "version": "0.8.0",
  "build": {
    "frontendDist": "../public",
    "beforeDevCommand": "bun run build:extensions",
    "beforeBuildCommand": "bun run build:extensions"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' mediastream:;",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./entitlements.plist",
      "infoPlist": "./Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../public": "public",
      "../extensions/dist": "extensions"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zh2209645/ompcot/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGM0ZERDkxRkM1NzkwMzUKUldRMWtGZjhrZDAvUHg1SFNtWnIwQkxGYTNNN3RkOTdLVlU3UGQraHpPSzFqbTkwZEJRQTd6c24K"
    }
  }
}
