node_modules/
.npm-cache/
.DS_Store

# Tauri build artifacts
src-tauri/target/
src-tauri/gen/

# Pi extension bundles (produced by scripts/build-extensions.js)
extensions/dist/

# Embedded pi binary tree (produced by scripts/fetch-pi-binary.js)
src-tauri/resources/pi/
.cache/pi-binaries/

# Debug bundles + rendered-page dumps exported from Settings → Configuration → Debug
# (they carry transcript ids and console output; never commit one)
ompcot-debug-*.json
ompcot-render-*.html

# Session exports (omp names them omp-session-*; pi-session-* is the old prefix)
pi-session-*.html
omp-session-*.html

# Screenshots dropped into the workspace while testing (the OS's own names)
屏幕截图*.png
Screenshot*.png

# Legacy bundled-omp layout (omp now comes from PATH)
src-tauri/resources/omp/
